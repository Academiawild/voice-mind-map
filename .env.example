# Copy this file to .env, then fill in your own settings.
# Do not upload .env to GitHub.

LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen-q4kp
LOCAL_AI_CONTEXT=16384

# Local app settings. Usually you do not need to edit these.
DEBUG_MINDMAP=false
PORT=8787
VITE_PORT=5173
FUNASR_WS_PORT=10095
FUNASR_HTTP_PORT=10096

# Local speech settings. Usually you do not need to edit these.
# Optional override. The default path points to the local macOS virtual environment.
# FUNASR_PYTHON=dependencies/local/asr-venv/bin/python
FUNASR_MODEL=paraformer-zh
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc

LOCAL_SHUTDOWN_TOKEN=
